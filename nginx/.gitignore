# Ignore all secure state data generated by the container
config/etc/
config/keys/
config/fail2ban/
config/log/
config/dns-conf/
config/php/
config/www/

# Ignore base nginx configuration files, but keep directories
config/nginx/*.*
config/nginx/site-confs/

# Explicitly ignore those annoying hidden tracker files
config/.migrations
config/.donoteditthisfile.conf

# Ignore all auto-generated sample configurations
config/**/*.sample

# Keep your custom setup files
!config/nginx/http_upgrade.conf
!config/nginx/proxy-confs/

ddclient.conf
