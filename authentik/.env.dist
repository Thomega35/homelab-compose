# Postgres credentials
PG_USER=authentik
PG_DB=authentik
AUTHENTIK_DB_PASSWORD=change_me_strong_password

# Authentik secret key — generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# LDAP outpost token — obtain from the Authentik admin UI after setup
AUTHENTIK_LDAP_TOKEN=change_me
