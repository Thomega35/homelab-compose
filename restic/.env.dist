# Copy to .env and fill in, and copy each secrets/*.dist to secrets/ without the .dist suffix.
# See https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html

# Main repository (local NAS). Password from secrets/restic-password.
RESTIC_REPOSITORY=/mnt/nas/backups/restic
RESTIC_PASSWORD_FILE=/run/secrets/restic_password

# Space-separated list of paths to back up (/mnt/nas-images = Immich UPLOAD_LOCATION, /mnt/nas/Documents = NAS Documents folder)
BACKUP_PATHS="/data /home/thome/homelab-compose /home/thome/makabe /home/thome/LabOrchestra /mnt/nas-images /mnt/nas/Documents"

# Where Postgres dumps are written (must be inside BACKUP_PATHS)
DUMP_DIR=/data/backups/postgres

# Home Assistant backup (backup.sh --ha): long-lived access token of an admin user. Leave empty to skip.
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
# Not used by backup.sh: needed to restore Home Assistant backups, kept here so it ends up in the restic backup.
HA_ENCRYPTION_KEY=

# Second copy (backup.sh --push): WD My Cloud share mounted on the Pi at /mnt/wdmycloud, over SFTP.
# Uses secrets/rpi-ssh-key, secrets/rpi-ssh-passphrase and secrets/rpi-known-hosts. Leave empty to skip.
RPI_REPOSITORY=sftp:<user>@<pi-host>:/mnt/wdmycloud/restic-thome-server
