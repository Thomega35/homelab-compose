# MeshCentral backup encryption password
# Change this value before first production run.
ADMIN_PASSWORD=change_this_to_a_strong_password

# Stable MeshCentral session key. Generate with: openssl rand -hex 32
SESSION_KEY=change_this_to_a_stable_session_key

# Authentik OIDC settings. MeshCentral enables OIDC only when issuer, client ID, and client secret are all set.
OIDC_ISSUER_URL=https://auth.thomega.fr/application/o/meshcentral/
OIDC_CLIENT_ID=your_authentik_client_id_here
OIDC_CLIENT_SECRET=your_authentik_client_secret_here
OIDC_REDIRECT_URI=https://mesh.thomega.fr/auth-oidc-callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://mesh.thomega.fr/login
OIDC_END_SESSION_ENDPOINT=
OIDC_NEW_ACCOUNTS=true
# Set this to the Authentik group whose members should be MeshCentral site admins.
OIDC_ADMIN_GROUP=admin
OIDC_REQUIRED_GROUP=
