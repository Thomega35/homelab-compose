AUTH_MODE=oidc_enforced
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
CSRF_SECRET=change_me_generate_with_openssl_rand_hex_32
OIDC_PROVIDER_NAME=Authentik
OIDC_ISSUER_URL=https://auth.thomega.fr/application/o/excalidash/
OIDC_CLIENT_ID=your_authentik_client_id_here
OIDC_CLIENT_SECRET=your_authentik_client_secret_here
OIDC_REDIRECT_URI=https://excalidash.thomega.fr/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=excalidash-admins
# Set this only if your Authentik provider does not emit email_verified=true.
OIDC_REQUIRE_EMAIL_VERIFIED=false