# Copy this file to .env and customize values as needed.
# These are the values this stack expects.

# Shared Traefik network and TLS entrypoint
TRAEFIK_NETWORK_NAME=traefik-net
TRAEFIK_ENTRYPOINT=websecure

# Public hostname exposed through Traefik
SCREEPS_HOST=screeps.thomega.fr

# Optional overrides if you need to change the default relay port, image, or timezone.
# SCREEPS_PORT=3000
# SCREEPS_IMAGE=ghcr.io/thomega35/screeps-relay:latest
# TZ=Europe/Paris

# Upstream relay integration values used by the Screeps script.
# Fill these in for the webhook/token flow.
# WEBHOOK_URL=https://discord.example.com/webhook
# SCREEPS_TOKEN=replace-me
